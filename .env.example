# ==============================================================================
# PokéVerse — Variáveis de Ambiente (Template)
# Copie para `.env` na raiz do repositório antes de subir a infra local.
# Nunca versione o arquivo `.env` real.
# ==============================================================================

# --- Back-end NestJS (apps/api) ---
NODE_ENV=development
API_PORT=3000
TRUST_PROXY=0
CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
APP_ENCRYPTION_KEY=TROQUE_CHAVE_AES_256_COM_NO_MINIMO_64_HEX_OU_32_CHARS
SESSION_TTL_SEC=900
REFRESH_TTL_DAYS=7
OTP_TTL_SEC=600
OTP_MAX_ATTEMPTS=3
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=
POKEAPI_TIMEOUT_MS=8000

# --- E-mail Assíncrono (Dev: Mailpit SMTP | Prod: Resend / SMTP TLS) ---
MAIL_TRANSPORT=smtp
MAIL_FROM=PokéVerse OS <no-reply@pokeverse.local>
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
RESEND_API_KEY=
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# --- Google OAuth 2.0 PKCE & WebAuthn Passkeys (Etapa 2B — opcionais em dev até configurar) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:4200/api/v1/auth/google/callback
WEBAUTHN_RP_NAME=PokéVerse OS
WEBAUTHN_RP_ID=127.0.0.1
WEBAUTHN_ORIGIN=http://127.0.0.1:4200

# --- PostgreSQL 16 (Docker local em 5433 | Neon Cloud em produção: URL -pooler + URL direta para migrations) ---
POSTGRES_USER=pokeverse
POSTGRES_PASSWORD=TROQUE_ESTA_SENHA_POSTGRES
POSTGRES_DB=pokeverse
POSTGRES_PORT=5433
DATABASE_URL=postgresql://pokeverse:TROQUE_ESTA_SENHA_POSTGRES@localhost:5433/pokeverse?schema=public
DATABASE_URL_UNPOOLED=postgresql://pokeverse:TROQUE_ESTA_SENHA_POSTGRES@localhost:5433/pokeverse?schema=public

# --- Redis 7 ---
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# --- Redpanda (Kafka-compatible local) / Aiven for Apache Kafka (Prod TLS) ---
REDPANDA_KAFKA_PORT=19092
REDPANDA_PROXY_PORT=18082
REDPANDA_CONSOLE_PORT=8085
KAFKA_BROKERS=localhost:19092
KAFKA_SSL=false
KAFKA_SSL_CA_PEM=
KAFKA_SSL_CERT_PEM=
KAFKA_SSL_KEY_PEM=
KAFKA_SASL_MECHANISM=
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=
KAFKA_CONNECT_TIMEOUT_MS=10000
KAFKA_REPLICATION_FACTOR=1
KAFKA_AUTO_CREATE_TOPICS=true

# --- MinIO / Silo (Dev S3) / Cloudflare R2 (Prod Fase 5+) ---
S3_ENABLED=true
MINIO_ROOT_USER=pokeverse_minio
MINIO_ROOT_PASSWORD=TROQUE_ESTA_SENHA_MINIO_8_CHARS
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ENDPOINT=http://localhost:9000
S3_BUCKET_ROMS=pokeverse-roms
S3_BUCKET_SAVES=pokeverse-saves

# --- Observabilidade OpenTelemetry & Stack Local (Grafana + Prometheus + Loki + Tempo) ---
OTEL_ENABLED=true
OTEL_SERVICE_NAME=pokeverse-api
OTEL_SERVICE_VERSION=0.1.0
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_COLLECTOR_GRPC_PORT=4317
OTEL_COLLECTOR_HTTP_PORT=4318
OTEL_PROM_PORT=8889
PROMETHEUS_PORT=9090
POSTGRES_EXPORTER_PORT=9187
REDIS_EXPORTER_PORT=9121
LOKI_PORT=3100
TEMPO_PORT=3200
GRAFANA_PORT=3005
GRAFANA_ADMIN_USER=pokeverse_admin
GRAFANA_ADMIN_PASSWORD=TROQUE_SENHA_GRAFANA_LOCAL

# --- APM & Crash Reporting SaaS (Sentry + Datadog Pro Student) ---
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=pokeverse@0.1.0
DD_API_KEY=
DD_SITE=datadoghq.com
DD_ENV=development
DD_APM_PORT=8126
DD_DOGSTATSD_PORT=8125
