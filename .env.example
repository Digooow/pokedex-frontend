# ==============================================================================
# PokéVerse — Variáveis de Ambiente (Template)
# Copie para `.env` na raiz do repositório antes de subir a infra local.
# Nunca versione o arquivo `.env` real.
# ==============================================================================

# --- Back-end NestJS (apps/api) ---
NODE_ENV=development
API_PORT=3000
CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# --- PostgreSQL 16 (Docker mapeado em 5433 para evitar conflito com 5432 local) ---
POSTGRES_USER=pokeverse
POSTGRES_PASSWORD=TROQUE_ESTA_SENHA_POSTGRES
POSTGRES_DB=pokeverse
POSTGRES_PORT=5433
DATABASE_URL=postgresql://pokeverse:TROQUE_ESTA_SENHA_POSTGRES@localhost:5433/pokeverse?schema=public

# --- Redis 7 ---
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# --- Redpanda (Kafka-compatible) & Console (8085 para evitar conflito com 8080) ---
REDPANDA_KAFKA_PORT=19092
REDPANDA_PROXY_PORT=18082
REDPANDA_CONSOLE_PORT=8085
KAFKA_BROKERS=localhost:19092

# --- MinIO / Silo (S3 compatível — senha exige no mínimo 8 caracteres) ---
MINIO_ROOT_USER=pokeverse_minio
MINIO_ROOT_PASSWORD=TROQUE_ESTA_SENHA_MINIO_8_CHARS
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ENDPOINT=http://localhost:9000
S3_BUCKET_ROMS=pokeverse-roms
S3_BUCKET_SAVES=pokeverse-saves
