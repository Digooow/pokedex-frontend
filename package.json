{
  "name": "pokeverse-monorepo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "infra:up": "docker compose --env-file .env -f infra/docker/docker-compose.yml up -d",
    "infra:down": "docker compose --env-file .env -f infra/docker/docker-compose.yml down",
    "infra:datadog:up": "docker compose --env-file .env -f infra/docker/docker-compose.yml --profile datadog up -d",
    "infra:datadog:down": "docker compose --env-file .env -f infra/docker/docker-compose.yml --profile datadog down",
    "build:shared": "npm run build --workspace=@pokeverse/shared",
    "build:api": "npm run build --workspace=pokeverse-api",
    "build:web": "npm run build --workspace=pokeverse-web",
    "build": "npm run build:shared && npm run build:api && npm run build:web",
    "dev:api": "npm run start:dev --workspace=pokeverse-api",
    "dev:web": "npm run start --workspace=pokeverse-web",
    "typecheck": "npm run typecheck --workspace=@pokeverse/shared && npm run typecheck --workspace=pokeverse-api && npm run typecheck --workspace=pokeverse-web",
    "test": "npm run test --workspace=@pokeverse/shared && npm run test --workspace=pokeverse-api && npm run test --workspace=pokeverse-web -- --watch=false",
    "test:e2e:api": "npm run test:e2e --workspace=pokeverse-api",
    "test:e2e:web": "npm run test:e2e --workspace=pokeverse-web",
    "test:e2e": "npm run test:e2e:api && npm run test:e2e:web",
    "lint:shared": "npm run lint --workspace=@pokeverse/shared",
    "lint:api": "npm run lint --workspace=pokeverse-api",
    "lint:web": "npm run lint --workspace=pokeverse-web",
    "lint": "npm run lint:shared && npm run lint:api && npm run lint:web",
    "format:check": "prettier --check \"packages/shared/src/**/*.ts\" \"apps/api/{src,test}/**/*.ts\" \"apps/web/{src,cloudflare,e2e}/**/*.ts\" \"apps/web/playwright.config.ts\"",
    "audit:ui": "node scripts/ui-quality-gate.mjs"
  },
  "devDependencies": {
    "@neon/config": "^1.14.4",
    "@neon/env": "^2.1.7",
    "@prisma/config": "^6.19.3"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.2",
    "effect": "^3.22.5"
  }
}
