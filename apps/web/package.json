{
  "name": "pokeverse-web",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "prestart": "node ../../scripts/sync-draco-assets.mjs",
    "start": "ng serve",
    "prebuild": "node ../../scripts/sync-draco-assets.mjs",
    "build": "ng build",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.e2e.json --noEmit",
    "lint": "eslint --max-warnings=0 \"src/**/*.ts\" \"cloudflare/**/*.ts\" \"e2e/**/*.ts\" \"playwright.config.ts\"",
    "format": "prettier --write \"src/**/*.ts\" \"cloudflare/**/*.ts\" \"e2e/**/*.ts\" \"playwright.config.ts\"",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:e2e": "playwright test"
  },
  "private": true,
  "packageManager": "npm@11.13.0",
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@pokeverse/shared": "0.1.0",
    "@simplewebauthn/browser": "^14.0.0",
    "rxjs": "~7.8.0",
    "socket.io-client": "^4.8.4",
    "three": "^0.187.0",
    "tslib": "^2.3.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@angular/build": "^22.2.7",
    "@angular/cli": "^22.2.7",
    "@angular/compiler-cli": "^22.2.0",
    "@playwright/test": "^1.65.1",
    "@types/three": "^0.187.0",
    "jsdom": "^30.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0"
  }
}
