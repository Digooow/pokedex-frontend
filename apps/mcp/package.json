{
  "name": "@pokeverse/mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "pokeverse-mcp": "./dist/index.js"
  },
  "scripts": {
    "build": "tsup",
    "dev": "node --watch dist/index.js",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --max-warnings=0 \"src/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\"",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@pokeverse/shared": "0.1.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsup": "^9.0.0",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0"
  }
}
